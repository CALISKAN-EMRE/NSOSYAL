# ==============================================================================
# NSosyal Pusula - Environment Configuration Template
# ==============================================================================
# Note: Do not put sensitive secrets or real credentials in this file.
# Copy this file to .env for local development.

# Application Settings
ENVIRONMENT=development
DEBUG=true
APP_NAME="NSosyal Pusula"
APP_VERSION="0.1.0"

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Data Source Adapter Configuration
# Supported options: 'json' (for local demo mock), 'api' (for future NSosyal API integration)
DATA_SOURCE_TYPE=json
DEMO_DATA_PATH=../data/demo_posts.json

# Future AI / Model Configurations (Mock / Local Heuristics by default)
AI_EMBEDDING_PROVIDER=mock
AI_MODERATION_PROVIDER=heuristic
AI_RECOMMENDATION_PROVIDER=rule_based

# Optional External API Keys (Leave empty for Phase 1 Demo Mode)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# HUGGINGFACE_API_KEY=
